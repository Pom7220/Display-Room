<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0a0a12"
    android:fillViewport="true"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⬡ RIS KIOSK"
            android:textColor="#3b9eff"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginTop="40dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Room Display — Setup"
            android:textColor="#6b82a8"
            android:textSize="13sp"
            android:layout_marginBottom="32dp" />

        <!-- Step 1: Certificate -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="STEP 1 — SSL CERTIFICATE"
            android:textColor="#00e5c8"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Install the ISRG Root X1 certificate to remove the Chrome SSL warning on GitHub Pages. This is a one-time setup per tablet.\n\nNote: Android will ask you to set a screen lock (PIN) if one is not already set. Use a simple PIN like 0000."
            android:textColor="#8899bb"
            android:textSize="12sp"
            android:lineSpacingMultiplier="1.5"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btn_install_cert"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="🔒  Install Certificate"
            android:textColor="#ffffff"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="#2979ff"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btn_copy_cert"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:text="📁  Copy to Downloads (manual install)"
            android:textColor="#8899bb"
            android:textSize="12sp"
            android:background="#1a1a2e"
            android:layout_marginBottom="24dp" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1a2a44"
            android:layout_marginBottom="24dp" />

        <!-- Step 2: Launch -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="STEP 2 — LAUNCH DISPLAY"
            android:textColor="#00e5c8"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Opens Chrome to the Room Display. After first setup, this happens automatically on every reboot (10 second delay for WiFi)."
            android:textColor="#8899bb"
            android:textSize="12sp"
            android:lineSpacingMultiplier="1.5"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btn_launch"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="🚀  Launch Room Display"
            android:textColor="#040810"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="#00d68f"
            android:layout_marginBottom="32dp" />

        <!-- Info -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ℹ AUTO-BOOT: This app automatically launches Chrome to the Room Display after every device reboot. No manual action needed after initial setup.\n\n⚡ FULLSCREEN: Tap anywhere on the display once to enter fullscreen kiosk mode.\n\n🔄 UPDATES: The web app updates automatically from GitHub — no APK rebuild needed."
            android:textColor="#4a5d7a"
            android:textSize="11sp"
            android:lineSpacingMultiplier="1.6"
            android:background="#0d1526"
            android:padding="14dp"
            android:layout_marginBottom="20dp" />

        <!-- Version -->
        <TextView
            android:id="@+id/tv_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#3a4d6b"
            android:textSize="10sp"
            android:layout_marginBottom="20dp" />

    </LinearLayout>
</ScrollView>
